ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Pexels API key for stock B-roll clips. Get one free at:
# https://www.pexels.com/api/
PEXELS_API_KEY=...

# Optional: choose Claude model used to write scripts
CLAUDE_MODEL=claude-opus-4-7

# Optional: OpenAI TTS settings (tts-1-hd is highest quality)
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=onyx
