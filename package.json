{
  "name": "history-fact-videos",
  "version": "0.1.0",
  "private": true,
  "description": "Automated pipeline for generating animated English history/fact YouTube videos",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts HistoryVideo out/video.mp4 --concurrency=4",
    "render:4k": "remotion render src/index.ts HistoryVideo out/video-4k.mp4 --scale=2 --concurrency=4",
    "script": "tsx scripts/generate-script.ts",
    "narrate": "tsx scripts/generate-narration.ts",
    "images": "tsx scripts/fetch-images.ts",
    "media": "tsx scripts/fetch-media.ts",
    "create": "tsx scripts/pipeline.ts",
    "preview": "tsx scripts/preview-png.ts",
    "preview:explainer": "tsx scripts/preview-explainer.ts",
    "preview:real": "tsx scripts/preview-real.ts",
    "preview:final": "tsx scripts/preview-final.ts",
    "bgm": "tsx scripts/generate-bgm.ts",
    "guide": "tsx scripts/build-recording-guide.ts",
    "mix": "tsx scripts/mix-narration.ts",
    "pilot": "tsx scripts/build-pilot.ts",
    "final": "tsx scripts/build-final.ts",
    "upload-assets": "tsx scripts/build-upload-assets.ts",
    "thumbnail": "tsx scripts/build-thumbnail.ts",
    "shorts": "tsx scripts/build-shorts.ts",
    "swap-bgm": "tsx scripts/swap-bgm.ts",
    "scout-arxiv": "tsx scripts/scout-arxiv.ts",
    "scout-cspan": "tsx scripts/scout-cspan.ts",
    "scout-edgar": "tsx scripts/scout-edgar.ts",
    "scout-whitehouse": "tsx scripts/scout-whitehouse.ts",
    "scout-voa": "tsx scripts/scout-voa.ts",
    "download-cspan": "tsx scripts/download-cspan.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "translate-transcript": "tsx scripts/translate-transcript.ts",
    "find-moments": "tsx scripts/find-moments.ts",
    "draft-cspan-episode": "tsx scripts/draft-cspan-episode.ts",
    "arxiv-episode": "tsx scripts/build-arxiv-episode.ts",
    "episode": "tsx scripts/build-episode.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@remotion/bundler": "^4.0.230",
    "@remotion/cli": "^4.0.230",
    "@remotion/google-fonts": "^4.0.230",
    "@remotion/renderer": "^4.0.230",
    "dotenv": "^16.4.5",
    "openai": "^4.71.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.230",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "fast-xml-parser": "^5.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
